<Window x:Name="MainWindow" x:Class="SonnyBIM.FoundationFromCadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:Sonnybim="clr-namespace:SonnyBIM"
        d:DataContext="{d:DesignInstance Type=Sonnybim:FoundationFromCADViewModel}"
        Title="{Binding TitleCaption}"
        Height="350" Width="500"
        KeyDown="MainWindow_KeyDown"
        WindowStartupLocation="CenterScreen"
        Background="White"
        ResizeMode="CanResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- <ResourceDictionary Source="/SonnyBIMResources;component/WPFResource/SonnyBIMResource.xaml" /> -->
                <!--<ResourceDictionary Source="/SonnyBIM;component/02.Resources/Languages/OnlineLicense/UserLicenseWindow.vi.xaml" />-->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Main Content -->
    <Grid Grid.Row="1" x:Name="MainGrid">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Scrollable Content Area -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,5,0">

                    <!-- GROUP 1: LAYER SELECTION -->
                    <GroupBox Header="Layer Section" Margin="0,0,0,10">
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedLayerHint}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Margin="5,0,0,0"
                                      ItemsSource="{Binding AllLayers}"
                                      SelectedItem="{Binding SelectedLayer}"
                                      IsEditable="False"/>
                        </Grid>
                    </GroupBox>

                    <!-- GROUP 2: FOUNDATION TYPE -->
                    <GroupBox Header="Foundation Type" Margin="0,0,0,10">
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FoundationTypeHint}" VerticalAlignment="Center" Margin="0,5"/>
                            <ComboBox Grid.Column="1" Margin="5,5,0,5"
                                      ItemsSource="{Binding AllFloor}"
                                      SelectedItem="{Binding SelectedFloor}"
                                      DisplayMemberPath="Name"
                                      IsEditable="False"/>
                        </Grid>
                    </GroupBox>

                    <!-- GROUP 3: CONSTRAINTS -->
                    <GroupBox Header="Constraints" Margin="0,0,0,10">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="75"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="75"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Level & Offset -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LevelHint}" VerticalAlignment="Center" Margin="0,5"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="5,5,0,5"
                                      ItemsSource="{Binding AllLevel}"
                                      SelectedItem="{Binding SelectedLevel}"
                                      DisplayMemberPath="Name"
                                      IsEditable="False"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding OffsetHint}" VerticalAlignment="Center" Margin="0,5"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="5,5,0,5"
                                     Text="{Binding OffsetFromElevation}"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="{Binding OkCap}" Width="100" Height="30" Click="btnOk_Click" Margin="0,0,10,0"/>
                <Button Content="{Binding CancelCap}" Width="100" Height="30" Click="btnCancel_Click" IsCancel="True"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>
