<Window x:Name="MainWindow" x:Class="SonnyBIM.FramingFromCadWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            mc:Ignorable="d"
            xmlns:Sonnybim="clr-namespace:SonnyBIM"
            d:DataContext="{d:DesignInstance Type=Sonnybim:FramingFromCADViewModel}"
            Title="{Binding TitleCaption}"
            Height="600" Width="500"
            WindowStartupLocation="CenterScreen"
            KeyDown="MainWindow_KeyDown"

            Background="White"
            ResizeMode="CanResize"
            >

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- <ResourceDictionary Source="pack://application:,,,/Sonny.Framing;component/WPFResource/SonnyBIMResource.xaml" /> -->
                <!--<ResourceDictionary Source="/SonnyBIM;component/02.Resources/Languages/OnlineLicense/UserLicenseWindow.vi.xaml" />-->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

            <!-- Main Content -->
            <Grid Grid.Row="1" x:Name="MainGrid">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Scrollable Content Area -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,5,0">
                            <!-- GROUP 1: LAYER SELECTION -->
                            <GroupBox Header="Layer Selection" Margin="0,0,0,10">
                                <Grid Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SelectedLayerHint}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Margin="5,0,0,0"
                                              ItemsSource="{Binding AllLayers}"
                                              SelectedItem="{Binding SelectedLayer}"
                                              IsEditable="False"/>
                                </Grid>
                            </GroupBox>

                            <!-- GROUP 2: BEAM FAMILY -->
                            <GroupBox Header="Beam Family" Margin="0,0,0,10">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Beam Family -->
                                    <TextBlock Grid.Row="0" Text="{Binding SelectedFamilyFramingHint}"
                                               VerticalAlignment="Center" Margin="0,5" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="5,5,0,5"
                                              ItemsSource="{Binding AllFamiliesFraming}"
                                              SelectedItem="{Binding SelectedFamilyFraming}"
                                              DisplayMemberPath="Name"
                                              IsEditable="False"/>
                                    <!-- Width Parameter -->
                                    <TextBlock Grid.Row="1" Text="{Binding WidthParameterHint}"
                                               VerticalAlignment="Center" Margin="0,5" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="5,5,0,5"
                                              ItemsSource="{Binding AllFramingTypeParameter}"
                                              SelectedItem="{Binding WidthParameter}"
                                              IsEditable="False"/>
                                    <!-- Height Parameter -->
                                    <TextBlock Grid.Row="2" Text="{Binding HeightParameterHint}"
                                               VerticalAlignment="Center" Margin="0,5" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="5,5,0,5"
                                              ItemsSource="{Binding AllFramingTypeParameter}"
                                              SelectedItem="{Binding HeightParameter}"
                                              IsEditable="False"/>
                                    <!-- All Sections -->
                                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                                               Text="{Binding AllSectionsHint}"
                                               VerticalAlignment="Center" Margin="0,5,0,2" />
                                    <TextBox Grid.Row="4" Grid.ColumnSpan="2"
                                             Margin="0,2,0,5"
                                             ToolTip="{Binding AllSectionsToolTip}"
                                             Text="{Binding AllSections}" />
                                </Grid>

                            </GroupBox>

                            <!-- GROUP 3: LEVELS -->
                            <GroupBox Header="Levels" Margin="0,0,0,10">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Reference Level -->
                                    <TextBlock Grid.Row="0" Text="{Binding ReferenceLevelHint}" VerticalAlignment="Center" Margin="0,5" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="5,5,0,5"
                                              ItemsSource="{Binding AllLevel}"
                                              SelectedItem="{Binding ReferenceLevel}"
                                              DisplayMemberPath="Name"
                                              IsEditable="False"/>
                                    <!-- Z Offset -->
                                    <TextBlock Grid.Row="1" Text="{Binding ZOffsetHint}" VerticalAlignment="Center" Margin="0,5" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="5,5,0,5"
                                             ToolTip="{Binding ZOffsetToolTip}"
                                             Text="{Binding ZOffset}"/>
                                </Grid>
                            </GroupBox>

                            <!-- Additional Options (CheckBoxes) -->
                            <StackPanel Orientation="Horizontal" Margin="5,5,0,15">
                                <CheckBox Content="{Binding IsCreateForSingleLineCap}" Margin="0,0,20,0"
                                          ToolTip="{Binding IsCreateForSingleLineToolTip}"
                                          IsChecked="{Binding IsCreateForSingleLine}" />
                                <CheckBox Content="{Binding IsDisallowJoinCap}"
                                          IsChecked="{Binding IsDisallowJoin}"
                                          ToolTip="{Binding IsDisallowJoinToolTip}" />
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                    <!-- Footer Buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="{Binding OkCap}" Width="100" Height="30" Click="btnOk_Click" Margin="0,0,10,0" />
                        <Button Content="{Binding CancelCap}" Width="100" Height="30" Click="btnCancel_Click" IsCancel="True" />
                    </StackPanel>
                </Grid>

            </Grid>

</Window>
