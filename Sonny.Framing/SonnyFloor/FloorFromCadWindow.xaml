<Window x:Name="MainWindow" x:Class="SonnyBIM.FloorFromCadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:Sonnybim="clr-namespace:SonnyBIM"
        d:DataContext="{d:DesignInstance Type=Sonnybim:FloorFromCADViewModel}"

        Height="500" Width="550"
        WindowStartupLocation="CenterScreen"
        KeyDown="MainWindow_KeyDown"
        Background="White"
        ResizeMode="CanResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- <ResourceDictionary Source="/SonnyBIMResources;component/WPFResource/SonnyBIMResource.xaml" /> -->
                <!--<ResourceDictionary Source="/SonnyBIM;component/02.Resources/Languages/OnlineLicense/UserLicenseWindow.vi.xaml" />-->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Main Content -->
    <Grid Grid.Row="1" x:Name="MainGrid">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Scrollable Content Area -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,5,0">

                    <!-- GROUP 1: LAYER SELECTION -->
                    <GroupBox Header="Layer Selection" Margin="0,0,0,10">
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedLayerFloorHint}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Margin="5,0,0,0"
                                      ItemsSource="{Binding AllLayers}"
                                      SelectedItem="{Binding SelectedLayerFloor}"
                                      IsEditable="False"/>
                        </Grid>
                    </GroupBox>

                    <!-- GROUP 2: FLOOR TYPE -->
                    <GroupBox Header="Floor Type" Margin="0,0,0,10">
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedFloorHint}" VerticalAlignment="Center" Margin="0,5"/>
                            <ComboBox Grid.Column="1" Margin="5,5,0,5"
                                      ItemsSource="{Binding AllFloor}"
                                      SelectedItem="{Binding SelectedFloor}"
                                      DisplayMemberPath="Name"
                                      IsEditable="False"/>
                        </Grid>
                    </GroupBox>

                    <!-- GROUP 3: CONSTRAINTS -->
                    <GroupBox Header="Constraints" Margin="0,0,0,10">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="75"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="75"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Level & Offset -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding SelectedLevelHint}"
                                       VerticalAlignment="Center" Margin="0,5"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="5,5,10,5"
                                      ItemsSource="{Binding AllLevel}"
                                      SelectedItem="{Binding SelectedLevel}"
                                      DisplayMemberPath="Name"
                                      IsEditable="False"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LevelOffsetHint}"
                                       VerticalAlignment="Center" Margin="0,5"/>
                            <TextBox Grid.Row="0" Grid.Column="3" Margin="5,5,0,5"
                                     ToolTip="{Binding LevelOffsetTooltip}"
                                     Text="{Binding LevelOffset}"/>
                        </Grid>
                    </GroupBox>

                    <!-- GROUP 4: OPTIONS -->
                    <GroupBox Header="Options" Margin="0,0,0,10">
                        <Grid Margin="5">
                            <StackPanel Orientation="Vertical">
                                <CheckBox Content="{Binding OnlyCreateBoundaryLineCap}" Margin="0,0,0,10"
                                          IsChecked="{Binding OnlyCreateBoundaryLine, UpdateSourceTrigger=PropertyChanged}"/>
                                <CheckBox Content="{Binding CreateBoundaryLineOfHatchCap}" Margin="0,0,0,0"
                                          IsChecked="{Binding CreateBoundaryLineOfHatch, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="{Binding OkCap}" Width="100" Height="30" Click="btnOk_Click" Margin="0,0,10,0"/>
                <Button Content="{Binding CancelCap}" Width="100" Height="30" Click="btnCancel_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
