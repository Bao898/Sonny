<Window x:Name="MainWindow" x:Class="SonnyBIM.PileFromCadWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            mc:Ignorable="d"
            xmlns:Sonnybim="clr-namespace:SonnyBIM"
            d:DataContext="{d:DesignInstance Type=Sonnybim:PileFromCADViewModel}"

            Height="500" Width="500"
            WindowStartupLocation="CenterScreen"
            KeyDown="MainWindow_KeyDown"
            Background="White"
            ResizeMode="CanResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- <ResourceDictionary Source="/SonnyBIMResources;component/WPFResource/SonnyBIMResource.xaml" /> -->
                <!--<ResourceDictionary Source="/SonnyBIM;component/02.Resources/Languages/OnlineLicense/UserLicenseWindow.vi.xaml" />-->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

        <!-- Main Content -->
        <Grid Grid.Row="1" x:Name="MainGrid">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Scrollable Content Area -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,5,0">

                        <!-- GROUP 1: LAYER SELECTION -->
                        <GroupBox Header="Layer Section" Margin="0,0,0,10">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SelectedLayerHint}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Margin="5,0,0,0"
                                          ItemsSource="{Binding AllLayers}"
                                          SelectedItem="{Binding SelectedLayer}"
                                          IsEditable="False"/>
                            </Grid>
                        </GroupBox>

                        <!-- GROUP 2: CREATION METHOD (GEOMETRY) -->
                        <GroupBox Header="Geometry Method" Margin="0,0,0,10">
                            <StackPanel Margin="5">

                                <!-- Cách 1: Dựng từ 2 Line -->
                                <RadioButton IsChecked="{Binding IsModelByTwoLine, UpdateSourceTrigger=PropertyChanged}"
                                             Content="{Binding TenModelByTwoLine}"
                                             GroupName="ChonTypeGeometry"
                                             Name="NameIsModelByTwoLine"
                                             FontWeight="SemiBold"
                                             Margin="0,0,0,5"/>
                                <Grid Margin="20,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PileTypeHint}"
                                               VerticalAlignment="Center"
                                               IsEnabled="{Binding ElementName=NameIsModelByTwoLine, Path=IsChecked}"/>
                                    <ComboBox Grid.Column="1" Margin="5,0,0,0"
                                              IsEnabled="{Binding ElementName=NameIsModelByTwoLine, Path=IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding AllPile}"
                                              SelectedItem="{Binding SelectedPile}"
                                              DisplayMemberPath="Name"
                                              IsEditable="False"/>
                                </Grid>

                                <Separator Margin="0,5,0,10"/>

                                <!-- Cách 2: Dựng từ Circle -->
                                <RadioButton IsChecked="{Binding IsModelByCircle, UpdateSourceTrigger=PropertyChanged}"
                                             Content="{Binding TenModelByCircle}"
                                             GroupName="ChonTypeGeometry"
                                             Name="NameIsModelByCircle"
                                             FontWeight="SemiBold"
                                             Margin="0,0,0,5"/>
                                <Grid Margin="20,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TenAllFamily}"
                                               VerticalAlignment="Center"
                                               IsEnabled="{Binding ElementName=NameIsModelByCircle, Path=IsChecked}"/>
                                    <ComboBox Grid.Column="1" Margin="5,0,0,0"
                                              IsEnabled="{Binding ElementName=NameIsModelByCircle, Path=IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding AllFamilies}"
                                              SelectedItem="{Binding SelectedFamily}"
                                              DisplayMemberPath="Name"
                                              IsEditable="True"/>
                                </Grid>

                                <Grid Margin="20,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TenDiameterCirclePilePara}"
                                               VerticalAlignment="Center"
                                               IsEnabled="{Binding ElementName=NameIsModelByCircle, Path=IsChecked}"/>
                                    <ComboBox Grid.Column="1" Margin="5,0,0,0"
                                              IsEnabled="{Binding ElementName=NameIsModelByCircle, Path=IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding AllPileTypeParameter}"
                                              SelectedItem="{Binding SelectDiameterCirclePilePara}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- GROUP 3: CONSTRAINTS -->
                        <GroupBox Header="Constraints" Margin="0,0,0,10">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Level -->
                                <TextBlock Grid.Column="0" Text="{Binding SelectedLevelHint}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Margin="5,0,0,0"
                                          ItemsSource="{Binding AllLevels}"
                                          SelectedItem="{Binding SelectedLevel}"
                                          DisplayMemberPath="Name"
                                          IsEditable="False"/>
                            </Grid>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Buttons -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="{Binding OkCap}" Width="100" Height="30" Click="btnOk_Click" Margin="0,0,10,0"/>
                    <Button Content="{Binding CancelCap}" Width="100" Height="30" Click="btnCancel_Click" IsCancel="True"/>
                </StackPanel>

            </Grid>
        </Grid>
</Window>
