<Window x:Name="MainWindow" x:Class="SonnyBIM.PileCoordinateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:sonnybim="clr-namespace:SonnyBIM"
        d:DataContext="{d:DesignInstance Type=sonnybim:PileCoordinateViewModel}"

        Height="320" Width="520"
        WindowStartupLocation="CenterScreen"
        KeyDown="MainWindow_KeyDown"
        Background="White"
        ResizeMode="CanResize"
        Title="{Binding TitleCaption}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- <ResourceDictionary Source="/SonnyBIMResources;component/WPFResource/SonnyBIMResource.xaml" /> -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10" x:Name="MainPanel">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Content -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,5,0">

                <!-- GROUP 1: Base coordinate system -->
                <GroupBox Header="{Binding CoordinateBaseCap}" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <RadioButton Content="{Binding SurveyPointCap}"
                                     GroupName="CoordinateBase"
                                     IsChecked="{Binding IsSurveyPoint}"
                                     Margin="0,0,15,0"
                                     MinWidth="100"/>

                        <RadioButton Content="{Binding ProjectBasePointCap}"
                                     GroupName="CoordinateBase"
                                     IsChecked="{Binding IsProjectBasePoint}"
                                     Margin="0,0,15,0"/>

                        <RadioButton Content="{Binding InternalOriginCap}"
                                     GroupName="CoordinateBase"
                                     IsChecked="{Binding IsInternalOrigin}"/>
                    </StackPanel>
                </GroupBox>

                <!-- GROUP 2: Scope -->
                <GroupBox Header="{Binding ScopePilesCap}" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <RadioButton Content="{Binding EntireModelCap}"
                                     GroupName="ScopePiles"
                                     IsChecked="{Binding IsEntireModel}"
                                     Margin="0,0,15,0"/>

                        <RadioButton Content="{Binding CurrentViewCap}"
                                     GroupName="ScopePiles"
                                     IsChecked="{Binding IsCurrentView}"
                                     Margin="0,0,15,0"/>

                        <RadioButton Content="{Binding CurrentSelectionCap}"
                                     GroupName="ScopePiles"
                                     IsChecked="{Binding IsCurrentSelection}"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="{Binding OkCap}"
                    Width="100"
                    Height="30"
                    Click="btnOk_Click"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
