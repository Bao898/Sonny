<Window x:Name="MainWindow" x:Class="SonnyBIM.PileCoordinateWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            mc:Ignorable="d"
            xmlns:Sonnybim="clr-namespace:SonnyBIM"
            d:DataContext="{d:DesignInstance Type=Sonnybim:PileCoordinateViewModel}"

            Height="500" Width="500"
            WindowStartupLocation="CenterScreen"
            KeyDown="MainWindow_KeyDown"
            Background="White"
            ResizeMode="CanResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- <ResourceDictionary Source="/SonnyBIMResources;component/WPFResource/SonnyBIMResource.xaml" /> -->
                <!--<ResourceDictionary Source="/SonnyBIM;component/02.Resources/Languages/OnlineLicense/UserLicenseWindow.vi.xaml" />-->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

        <!-- Main Content -->
        <Grid Grid.Row="1" x:Name="MainGrid">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Scrollable Content Area -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,5,0">

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Buttons -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="{Binding OkCap}" Width="100" Height="30" Click="btnOk_Click" Margin="0,0,10,0"/>
                    <Button Content="{Binding CancelCap}" Width="100" Height="30" Click="btnCancel_Click" IsCancel="True"/>
                </StackPanel>

            </Grid>
        </Grid>
</Window>
