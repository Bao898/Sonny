<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ResourceDictionary.MergedDictionaries>
        <!-- MaterialDesign -->
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.TreeView.xaml" />

        <!-- Custom Styles -->
        <ResourceDictionary Source="SonnyColors.xaml" />
        <ResourceDictionary Source="GeneralStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Style cho TreeView -->
    <Style x:Key="SonnyBIM_TreeViewDefaultStyle" TargetType="TreeView"
           BasedOn="{StaticResource MaterialDesignTreeView}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource MauChinhSonnyBIM}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!--<Setter Property="Padding" Value="4"/>-->
        <Setter Property="Margin" Value="4"/>
        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
        <!--<Setter Property="materialDesign:ScrollViewerAssist.ButtonsVisibility" Value="Visible"/>-->
    </Style>

    <!-- Style cho TreeViewItem -->
    <Style x:Key="SonnyBIM_TreeViewItemDefaultStyle" TargetType="TreeViewItem"
           BasedOn="{StaticResource MaterialDesignTreeViewItem}">
        <!--<Setter Property="Padding" Value="8,4"/>-->
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="materialDesign:TreeViewAssist.ExpanderSize" Value="20"/>
        <!--<Setter Property="materialDesign:TreeViewAssist.ExpanderForeground" Value="{StaticResource MauChinhSonnyBIM}"/>-->

        <Style.Triggers>
            <!-- Hiệu ứng hover -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource MauPhuSonnyBIM}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>

            <!-- Hiệu ứng khi chọn -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource MauChinhSonnyBIM}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
