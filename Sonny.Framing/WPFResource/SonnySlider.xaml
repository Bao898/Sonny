<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ResourceDictionary.MergedDictionaries>
        <!-- MaterialDesign -->
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Slider.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ProgressBar.xaml" />

        <!-- Custom Styles -->
        <ResourceDictionary Source="SonnyColors.xaml" />
        <ResourceDictionary Source="GeneralStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Style cho Slider -->
    <Style x:Key="SonnyBIM_Slider" TargetType="Slider"
           BasedOn="{StaticResource MaterialDesignSlider}">
        <Setter Property="Foreground" Value="{StaticResource MauChinhSonnyBIM}"/>
        <!--<Setter Property="Background" Value="#E0E0E0"/>-->
        <Setter Property="BorderBrush" Value="{StaticResource MauChinhSonnyBIM}"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging" Value="True"/>
    </Style>

    <!-- Style cho Horizontal Slider -->
    <Style x:Key="SonnyBIM_HorizontalSlider" TargetType="Slider"
           BasedOn="{StaticResource SonnyBIM_Slider}">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Height" Value="24"/>
    </Style>

    <!-- Style cho Vertical Slider -->
    <Style x:Key="SonnyBIM_VerticalSlider" TargetType="Slider"
           BasedOn="{StaticResource SonnyBIM_Slider}">
        <Setter Property="Orientation" Value="Vertical"/>
        <Setter Property="Width" Value="24"/>
    </Style>

    <!-- Style cho ProgressBar -->
    <Style x:Key="SonnyBIM_ProgressBar" TargetType="ProgressBar"
           BasedOn="{StaticResource MaterialDesignLinearProgressBar}">
        <Setter Property="Foreground" Value="{StaticResource MauChinhSonnyBIM}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource MauChinhSonnyBIM}"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Margin" Value="4"/>
        <!--<Setter Property="materialDesign:TransitionAssist.DisableTransitions" Value="False"/>-->
    </Style>

    <!-- Style cho ProgressBar Indeterminate -->
    <Style x:Key="SonnyBIM_IndeterminateProgressBar" TargetType="ProgressBar"
           BasedOn="{StaticResource SonnyBIM_ProgressBar}">
        <Setter Property="IsIndeterminate" Value="True"/>
        <!--<Setter Property="materialDesign:ProgressBarAssist." Value="{StaticResource MauChinhSonnyBIM}"/>
        <Setter Property="materialDesign:ProgressBarAssist.IndicatorBackground" Value="#E0E0E0"/>-->
    </Style>
</ResourceDictionary>
