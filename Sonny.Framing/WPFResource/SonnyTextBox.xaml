        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.TextBox.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.PasswordBox.xaml" />




        <!-- Custom Styles -->
        <ResourceDictionary Source="SonnyColors.xaml" />
        <ResourceDictionary Source="GeneralStyles.xaml" />

    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="SonnyBIM_TextBoxDefaultStyle"
            TargetType="{x:Type TextBox}"
            BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}"
           >
        <!--BasedOn="{StaticResource MaterialDesignTextBox}"-->

        <!-- MaterialDesign styling -->
        <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="White"/>
        <Setter Property="materialDesign:TextFieldAssist.UnderlineCornerRadius" Value="3"/>
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="3"/>
        <Setter Property="materialDesign:TextFieldAssist.RippleOnFocusEnabled" Value="True"/>
        <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource MauPhuSonnyBIM}"/>
        <Setter Property="materialDesign:HintAssist.FloatingScale" Value="0.85"/>
        <Setter Property="materialDesign:HintAssist.FloatingOffset" Value="0,-12"/>
        <Setter Property="materialDesign:TextFieldAssist.HasClearButton" Value="True"/>
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="BorderThickness" Value="0 0 0 1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{DynamicResource MauChinhSonnyBIM}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource MauChinhSonnyBIM_IsSelected}"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="25"/>
        <Setter Property="Margin" Value="4,6"/>
        <Setter Property="Padding" Value="0"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="LightBlue"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource MauChinhSonnyBIM}"/>
                <Setter Property="Background" Value="Transparent"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6"/>
                <Setter Property="Background" Value="#FFF8F8F8"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <Style x:Key="SonnyBIM_TextBoxFloatingHintStyle"
            TargetType="{x:Type TextBox}"
            BasedOn="{StaticResource SonnyBIM_TextBoxDefaultStyle}"
           >
    </Style>

    <Style x:Key="SonnyBIM_TextBoxCenteredStyle"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource SonnyBIM_TextBoxDefaultStyle}">
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SonnyBIM_TextBoxNumericStyle"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource SonnyBIM_TextBoxDefaultStyle}">
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <Style x:Key="SonnyBIM_TextBoxOutlinedStyle"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="3"/>
        <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{DynamicResource MauChinhSonnyBIM}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MauChinhSonnyBIM}"/>

        <Setter Property="CaretBrush" Value="{DynamicResource MauChinhSonnyBIM}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource MauChinhSonnyBIM_IsSelected}"/>
        <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource MauChinhSonnyBIM}"/>
        <Setter Property="materialDesign:HintAssist.FloatingScale" Value="0.85"/>
        <Setter Property="materialDesign:HintAssist.FloatingOffset" Value="0,-12"/>
        <Setter Property="materialDesign:TextFieldAssist.HasClearButton" Value="True"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="MinHeight" Value="25"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource MauChinhSonnyBIM_IsMouseOver}"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource MauChinhSonnyBIM}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SonnyBIM_TextBoxFilledStyle"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource MaterialDesignFilledTextBox}">
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="3"/>
        <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{DynamicResource MauChinhSonnyBIM}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MauChinhSonnyBIM}"/>

        <Setter Property="CaretBrush" Value="{DynamicResource MauChinhSonnyBIM}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource MauChinhSonnyBIM_IsSelected}"/>
        <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource MauChinhSonnyBIM}"/>
        <Setter Property="materialDesign:HintAssist.FloatingScale" Value="0.85"/>
        <Setter Property="materialDesign:HintAssist.FloatingOffset" Value="0,-12"/>
        <Setter Property="materialDesign:TextFieldAssist.HasClearButton" Value="True"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="MinHeight" Value="25"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource MauChinhSonnyBIM_IsMouseOver}"/>
                <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{DynamicResource MauPhuSonnyBIM}"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource MauChinhSonnyBIM}"/>
                <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{DynamicResource MauChinhSonnyBIM}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <Style x:Key="SonnyBIM_PasswordBoxDefaultStyle"
            TargetType="{x:Type PasswordBox}"
            BasedOn="{StaticResource MaterialDesignFloatingHintPasswordBox}"
           >

        <!-- MaterialDesign styling -->
        <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{DynamicResource MauChinhSonnyBIM}"/>
        <Setter Property="materialDesign:TextFieldAssist.UnderlineCornerRadius" Value="3"/>
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="3"/>
        <Setter Property="materialDesign:TextFieldAssist.RippleOnFocusEnabled" Value="True"/>
        <Setter Property="materialDesign:HintAssist.Foreground" Value="{DynamicResource MauPhuSonnyBIM}"/>
        <Setter Property="materialDesign:HintAssist.FloatingScale" Value="0.85"/>
        <Setter Property="materialDesign:HintAssist.FloatingOffset" Value="0,-12"/>
        <Setter Property="materialDesign:TextFieldAssist.HasClearButton" Value="True"/>
        <Setter Property="BorderBrush" Value="{StaticResource MauChinhSonnyBIM}"/>
        <Setter Property="BorderThickness" Value="0 0 0 1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{DynamicResource MauChinhSonnyBIM}"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="MinHeight" Value="25"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource MauChinhSonnyBIM_IsMouseOver}"/>
                <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{DynamicResource MauPhuSonnyBIM}"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource MauChinhSonnyBIM}"/>
                <Setter Property="Background" Value="Transparent"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6"/>
                <Setter Property="Background" Value="#FFF8F8F8"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
