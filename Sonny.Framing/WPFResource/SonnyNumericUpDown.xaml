<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:Sonnybim="clr-namespace:SonnyBIM.WPF.Controls">

    <ResourceDictionary.MergedDictionaries>
        <!-- MaterialDesign -->
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.TextBox.xaml" />

        <!-- Custom Styles -->
        <ResourceDictionary Source="SonnyColors.xaml" />
        <ResourceDictionary Source="GeneralStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Default Values -->
    <system:Double x:Key="NumericUpDown.DefaultHeight">32</system:Double>
    <system:Double x:Key="NumericUpDown.DefaultWidth">120</system:Double>
    <system:Double x:Key="NumericUpDown.DefaultFontSize">13</system:Double>
    <system:Double x:Key="NumericUpDown.DefaultButtonWidth">24</system:Double>
    <Thickness x:Key="NumericUpDown.DefaultMargin">4,2</Thickness>
    <Thickness x:Key="NumericUpDown.DefaultPadding">8,0</Thickness>
    <Thickness x:Key="NumericUpDown.DefaultButtonMargin">0</Thickness>
    <CornerRadius x:Key="NumericUpDown.DefaultCornerRadius">4</CornerRadius>

    <!-- Button Style for NumericUpDown -->
    <Style x:Key="NumericUpDownButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="{StaticResource NumericUpDown.DefaultButtonWidth}"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="{StaticResource NumericUpDown.DefaultButtonMargin}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource MauChinhSonnyBIM_IsMouseOver}"/>
                            <Setter Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource MauChinhSonnyBIM}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- NumericUpDown Control Template -->
    <ControlTemplate x:Key="NumericUpDownTemplate" TargetType="{x:Type Sonnybim:NumericUpDown}">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding materialDesign:TextFieldAssist.TextFieldCornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- TextBox for numeric input -->
                <TextBox x:Name="PART_TextBox"
                         Grid.Column="0"
                         Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="0"
                         Padding="{TemplateBinding Padding}"
                         TextAlignment="{TemplateBinding TextAlignment}"
                         VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                         HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                         Foreground="{TemplateBinding Foreground}"
                         FontSize="{TemplateBinding FontSize}"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontWeight="{TemplateBinding FontWeight}"
                         IsReadOnly="{TemplateBinding IsReadOnly}"
                         materialDesign:HintAssist.Hint="{TemplateBinding materialDesign:HintAssist.Hint}"
                         materialDesign:HintAssist.IsFloating="{TemplateBinding materialDesign:HintAssist.IsFloating}"
                         materialDesign:TextFieldAssist.HasClearButton="False"/>

                <!-- Buttons for increment/decrement -->
                <Grid Grid.Column="1" Margin="0,1,1,1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Increment Button -->
                    <Button x:Name="PART_IncreaseButton"
                            Grid.Row="0"
                            Style="{StaticResource NumericUpDownButtonStyle}">
                        <materialDesign:PackIcon Kind="ChevronUp"
                                                Width="16"
                                                Height="16"/>
                    </Button>

                    <!-- Decrement Button -->
                    <Button x:Name="PART_DecreaseButton"
                            Grid.Row="1"
                            Style="{StaticResource NumericUpDownButtonStyle}">
                        <materialDesign:PackIcon Kind="ChevronDown"
                                                Width="16"
                                                Height="16"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Base NumericUpDown Style -->
    <Style x:Key="SonnyBIM_NumericUpDownBaseStyle" TargetType="{x:Type Sonnybim:NumericUpDown}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource MauChinhSonnyBIM}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="{StaticResource NumericUpDown.DefaultFontSize}"/>
        <Setter Property="Height" Value="{StaticResource NumericUpDown.DefaultHeight}"/>
        <Setter Property="Width" Value="{StaticResource NumericUpDown.DefaultWidth}"/>
        <Setter Property="Margin" Value="{StaticResource NumericUpDown.DefaultMargin}"/>
        <Setter Property="Padding" Value="{StaticResource NumericUpDown.DefaultPadding}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Left"/>
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="{StaticResource NumericUpDown.DefaultCornerRadius}"/>
        <Setter Property="Template" Value="{StaticResource NumericUpDownTemplate}"/>
    </Style>

    <!-- Default NumericUpDown Style -->
    <Style x:Key="SonnyBIM_NumericUpDownDefaultStyle" TargetType="{x:Type Sonnybim:NumericUpDown}" BasedOn="{StaticResource SonnyBIM_NumericUpDownBaseStyle}">
        <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
    </Style>

    <!-- Centered NumericUpDown Style -->
    <Style x:Key="SonnyBIM_NumericUpDownCentered" TargetType="{x:Type Sonnybim:NumericUpDown}" BasedOn="{StaticResource SonnyBIM_NumericUpDownBaseStyle}">
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
    </Style>

    <!-- Flat NumericUpDown Style -->
    <Style x:Key="SonnyBIM_NumericUpDownFlat" TargetType="{x:Type Sonnybim:NumericUpDown}" BasedOn="{StaticResource SonnyBIM_NumericUpDownBaseStyle}">
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="0"/>
        <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
    </Style>

    <!-- Outlined NumericUpDown Style -->
    <Style x:Key="SonnyBIM_NumericUpDownOutlined" TargetType="{x:Type Sonnybim:NumericUpDown}" BasedOn="{StaticResource SonnyBIM_NumericUpDownBaseStyle}">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="4"/>
        <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
    </Style>
</ResourceDictionary>
