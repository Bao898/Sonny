<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ResourceDictionary.MergedDictionaries>

        <!-- MaterialDesign -->
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.RadioButton.xaml" />


        <!-- Custom Styles -->
        <ResourceDictionary Source="SonnyColors.xaml" />
        <ResourceDictionary Source="GeneralStyles.xaml" />

    </ResourceDictionary.MergedDictionaries>


    <Style x:Key="SonnyBIM_RadioButtonDefaultStyle"
           TargetType="RadioButton"
           BasedOn="{StaticResource MaterialDesignRadioButton}">

        <!-- MaterialDesign hỗ trợ -->
        <Setter Property="BorderBrush" Value="{StaticResource MauChinhSonnyBIM}"/>

        <!-- Giao diện thân thiện -->
        <Setter Property="Margin" Value="4,2"/>
        <!--<Setter Property="Padding" Value="8,2"/>-->
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource MauPhuSonnyBIM}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource MauPhuSonnyBIM}"/>
                <Setter Property="BorderBrush" Value="{StaticResource MauChinhSonnyBIM}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
