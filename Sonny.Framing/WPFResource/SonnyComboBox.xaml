    <!-- Style cho ComboBoxItem dùng chung -->
    <Style x:Key="SonnyBIM_ComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="MaxHeight" Value="28"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource MauPhuSonnyBIM}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="contentPresenter"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="TextElement.Foreground" TargetName="Bd" Value="{DynamicResource MaterialDesignCheckBoxDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Thay đổi màu nền khi rê chuột vào item -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource MauTitleBarSonnyBIM}" />
                <Setter Property="Foreground" Value="{DynamicResource MauPhuSonnyBIM}"/>
            </Trigger>

            <!-- Thay đổi màu nền khi item được chọn -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource MauTitleBarSonnyBIM}" />
                <Setter Property="Foreground" Value="{DynamicResource MauPhuSonnyBIM}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Style cho popup ComboBox -->
    <Style x:Key="SonnyBIM_ComboBoxDropdownStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MauChinhSonnyBIM}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <!-- Style cho ScrollViewer trong ComboBox -->
    <Style x:Key="SonnyBIM_ComboBoxScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="CanContentScroll" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollContentPresenter Grid.Column="0" Grid.Row="0"
                                            Margin="0"
                                            CanContentScroll="{TemplateBinding CanContentScroll}"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            SnapsToDevicePixels="True"
                                            UseLayoutRounding="True"/>

                        <ScrollBar Name="PART_VerticalScrollBar"
                                Grid.Column="1" Grid.Row="0"
                                Margin="0,0,0,0"
                                Orientation="Vertical"
                                ViewportSize="{TemplateBinding ViewportHeight}"
                                Maximum="{TemplateBinding ScrollableHeight}"
                                Minimum="0"
                                Value="{TemplateBinding VerticalOffset}"
                                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>

                        <ScrollBar Name="PART_HorizontalScrollBar"
                                Grid.Column="0" Grid.Row="1"
                                Margin="0,0,0,0"
                                Orientation="Horizontal"
                                ViewportSize="{TemplateBinding ViewportWidth}"
                                Maximum="{TemplateBinding ScrollableWidth}"
                                Minimum="0"
                                Value="{TemplateBinding HorizontalOffset}"
                                Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style cho VirtualizingStackPanel trong ComboBox -->
    <Style x:Key="SonnyBIM_ComboBoxVirtualizingPanelStyle" TargetType="{x:Type VirtualizingStackPanel}">
        <Setter Property="IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizationMode" Value="Recycling"/>
        <Setter Property="IsItemsHost" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="SonnyBIM_ComboBoxDefaultStyle"
           TargetType="ComboBox"
           BasedOn="{StaticResource MaterialDesignFloatingHintComboBox}"
           >

        <Setter Property="BorderBrush" Value="{StaticResource MauChinhSonnyBIM}"/>
        <Setter Property="BorderThickness" Value="0 0 0 1"/>
        <Setter Property="IsEditable" Value="True"/>
        <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{DynamicResource MauPhuSonnyBIM}"/>
        <Setter Property="materialDesign:HintAssist.FloatingScale" Value="0.85"/>
        <Setter Property="materialDesign:HintAssist.FloatingOffset" Value="0,-12"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Margin" Value="4,6"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="3"/>
        <Setter Property="Foreground" Value="{DynamicResource MauPhuSonnyBIM}"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Standard"/>
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>

        <!-- Thêm ItemContainerStyle để thay đổi màu nền khi rê chuột -->
        <Setter Property="ItemContainerStyle" Value="{StaticResource SonnyBIM_ComboBoxItemStyle}"/>
    </Style>

    <!-- Border cho ComboBox Popup -->
    <Style x:Key="SonnyBIM_ComboBoxPopupBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource MauChinhSonnyBIM}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="4" Color="Gray" Direction="315" Opacity="0.5" ShadowDepth="2"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style chung áp dụng cho ScrollViewer -->
    <Style TargetType="ScrollViewer" BasedOn="{StaticResource SonnyBIM_ComboBoxScrollViewerStyle}" />

    <!-- Style chung áp dụng cho VirtualizingStackPanel -->
    <Style TargetType="VirtualizingStackPanel" BasedOn="{StaticResource SonnyBIM_ComboBoxVirtualizingPanelStyle}" />



