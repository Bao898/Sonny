        <!-- Custom Styles -->
        <ResourceDictionary Source="SonnyColors.xaml" />
        <ResourceDictionary Source="GeneralStyles.xaml" />

    </ResourceDictionary.MergedDictionaries>

    <!-- Custom Style -->
    <Style x:Key="SonnyBIM_CheckBoxDefaultStyle"
           TargetType="CheckBox"
           BasedOn="{StaticResource MaterialDesignCheckBox}">

        <!-- MaterialDesign hỗ trợ -->
        <Setter Property="materialDesign:CheckBoxAssist.CheckBoxSize" Value="20" />
        <Setter Property="BorderBrush" Value="{StaticResource MauChinhSonnyBIM}"/>
        <Setter Property="Background" Value="Transparent"/>

        <!-- Giao diện thân thiện -->
        <!--<Setter Property="Padding" Value="8,2"/>-->
        <Setter Property="Margin" Value="4,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <!-- Hiệu ứng hover và checked -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource MauPhuSonnyBIM}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource MauPhuSonnyBIM}"/>
                <Setter Property="BorderBrush" Value="{StaticResource MauChinhSonnyBIM}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
        </Style.Triggers>
    </Style>


</ResourceDictionary>
