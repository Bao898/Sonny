<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:materialDesignCard="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    >


    <ResourceDictionary.MergedDictionaries>
        <!-- MaterialDesign -->
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Expander.xaml" />


        <!-- Custom Styles -->
        <ResourceDictionary Source="SonnyColors.xaml" />
        <ResourceDictionary Source="GeneralStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- BooleanToVisibilityConverter -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    <!-- Toggle button template cho Expander -->
    <Style x:Key="SonnyBIM_ExpanderToggleButtonStyle"
           TargetType="ToggleButton"
           BasedOn="{StaticResource MaterialDesignExpanderToggleButton}">
        <Setter Property="Foreground" Value="{DynamicResource MauChuButtonSonnyBIM}"/>
    </Style>

    <!--<Style x:Key="SonnyBIM_ExpanderRoundedStyle"-->
    <Style x:Key="SonnyBIM_ExpanderFlatStyle"
           TargetType="Expander"
           BasedOn="{StaticResource MaterialDesignExpander}"
           >

        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MauPhuSonnyBIM}"/>
        <!--<Setter Property="Padding" Value="4"/>-->
        <Setter Property="Margin" Value="4"/>
        <Setter Property="materialDesign:ExpanderAssist.HeaderBackground" Value="{DynamicResource MauChinhSonnyBIM}"/>
        <Setter Property="materialDesign:ExpanderAssist.HeaderFontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{DynamicResource SonnyBIM_TitleFontFamily}"/>

        <!-- Tắt hoàn toàn animation khi mở/đóng Expander -->
        <Setter Property="materialDesign:TransitionAssist.DisableTransitions" Value="True"/>
        <Setter Property="ExpandDirection" Value="Down"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <ContentPresenter Content="{Binding}"
                                     Margin="0"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Top"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <!-- Tùy chỉnh template để có chiều cao header giống GroupBox -->
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid>
                        <TextBlock Text="{Binding}"
                                  FontFamily="{DynamicResource SonnyBIM_TitleFontFamily}"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Margin="8,6"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <Style x:Key="SonnyBIM_ExpanderCardStyle"
           TargetType="Expander"
           BasedOn="{StaticResource MaterialDesignExpander}"
           >

        <Setter Property="Background" Value="White"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="materialDesign:ExpanderAssist.HeaderBackground" Value="{DynamicResource MauChinhSonnyBIM}"/>
        <Setter Property="materialDesign:ExpanderAssist.HeaderFontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{DynamicResource SonnyBIM_TitleFontFamily}"/>
        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MauPhuSonnyBIM}"/>

        <!-- Tắt hoàn toàn animation khi mở/đóng Expander -->
        <!--<Setter Property="materialDesign:TransitionAssist.DisableTransitions" Value="True"/>-->
        <Setter Property="ExpandDirection" Value="Down"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <ContentPresenter Content="{Binding}"
                                     Margin="0"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Top"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <!-- Tùy chỉnh template để có chiều cao header giống GroupBox -->
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid Height="38">
                        <TextBlock Text="{Binding}"
                                  FontFamily="{DynamicResource SonnyBIM_TitleFontFamily}"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource MauChuButtonSonnyBIM}"
                                  VerticalAlignment="Center"
                                  Margin="8,0"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <!-- Template mới cho Expander Card Style -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header với bo góc trên -->
                        <Border Grid.Row="0"
                                Background="{TemplateBinding materialDesign:ExpanderAssist.HeaderBackground}"
                                CornerRadius="4,4,0,0">
                            <DockPanel LastChildFill="True">
                                <ToggleButton x:Name="ExpanderButton"
                                             Style="{StaticResource SonnyBIM_ExpanderToggleButtonStyle}"
                                             FontWeight="{TemplateBinding FontWeight}"
                                             FontFamily="{TemplateBinding FontFamily}"
                                             IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                             Foreground="{TemplateBinding Foreground}"
                                             Margin="0"
                                             DockPanel.Dock="Left"/>
                                <ContentPresenter ContentSource="Header"
                                                 ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                 Margin="0"
                                                 VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- Content với bo góc dưới -->
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,0,1,1"
                                CornerRadius="0,0,4,4"
                                Visibility="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                           ContentSource="Content"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp3"/>
            </Trigger>
        </Style.Triggers>

    </Style>

</ResourceDictionary>
